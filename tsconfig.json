{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2023",

    "declaration": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,

    "sourceMap": true,
    "outDir": "./dist",

    "incremental": true,

    "skipLibCheck": true,
    "strictNullChecks": true,

    "forceConsistentCasingInFileNames": true,

    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": "./",
    "paths": {
      "@generated/*": ["node_modules/@generated/prisma-nestjs-graphql/*"],
      "@common/*": ["src/common/*"]
    }
  }
}