DATABASE_URL="your_db_connection_string"

# Dedicated secret for HMAC-SHA-256 OTP hashing (email verify, password reset, invitations)
# DO NOT reuse JWT_SECRET here — generate a separate 64-char hex string
TOKEN_HASH_SECRET="your_token_hash_secret_hex_string"

# Public base URL of this backend server (used to build magic links when FRONTEND_URL is not set)
APP_URL="http://localhost:3000"

# Optional: public URL of the frontend app.
# When set, magic links in emails point to the frontend instead of the backend.
# The frontend reads ?email= and ?token= query params and calls the verify API.
# Leave empty during development with no frontend.
FRONTEND_URL=""