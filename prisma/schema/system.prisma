
// we wil need an enum
enum ENAuditCategory {
  AUTH
  IAM
  CLUB
  PLAYER
  TRAINING
  MATCH
  MEDICAL
  FINANCE
  SYSTEM
  MEMBERSHIP
}

model AuditLog {
  id String @id @default(cuid())
  category ENAuditCategory
  action String
  entityType String
  description String

  metadata Json?

  createdBy String? @default("system") //user_id or system
  createdAt DateTime @default(now())
}