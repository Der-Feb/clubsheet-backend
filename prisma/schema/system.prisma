// we wil need an enum
enum ENAuditCategory {
  AUTH
  IAM
  CLUB
  TEAM
  PLAYER
  TRAINING
  MATCH
  MEDICAL
  FINANCE
  SYSTEM
  MEMBERSHIP
}

model AuditLog {
  id          String          @id @default(cuid(2))
  category    ENAuditCategory
  action      String
  entityType  String          @map("entity_type")
  description String

  metadata Json?

  createdBy String?  @default("system") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

enum ENNotificationType {
  SYSTEM
  TRAINING
  MATCH
}

model Notification {
  id String @id @default(cuid(2))

  type ENNotificationType @default(SYSTEM)

  title       String @db.VarChar(20)
  description String @db.VarChar(100)

  createdBy String? @default("system") @map("created_by")

  seenBy  User[] @relation("NotificationSeenBy") // people who marked it as seen
  sentFor User[] @relation("NotificationSentFor") // people the message is intended to reach

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
