enum ENFeature {
  IAM // Identity and Access Management

  // core features
  CLUB
  TEAM
  PLAYER

  // aux features
  TRAINING
  MATCH
  SIGNING
  MEDICAL
  FINANCE
}

model Feature {
  id String @id @default(cuid())

  code        ENFeature @unique
  name        String    @db.VarChar(50)
  description String?

  isCore Boolean @default(false) @map("is_core")
  isActive Boolean @default(true)  @map("is_active")  // platform-wide kill switch (unreleased/deprecated)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clubFeatures ClubFeature[]

  @@map("features")
}

enum ENClubFeatureStatus {
  ENABLED
  DISABLED
}

model ClubFeature {
  id String @id @default(cuid())

  clubId String @map("club_id")
  club   Club   @relation(fields: [clubId], references: [id])

  featureId String  @map("feature_id")
  feature   Feature @relation(fields: [featureId], references: [id])

  status ENClubFeatureStatus @default(DISABLED)

  enabledById String?     @map("enabled_by")
  enabledBy   Membership? @relation(fields: [enabledById], references: [id])
  enabledAt   DateTime?   @map("enabled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([clubId, featureId])
  @@index([clubId])
  @@map("club_features")
}

// -- Training Feature --

enum ENTrainingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ENTrainingType {
  PHYSICAL
  MENTAL
  TECHNICAL
  TACTICAL
}

model Training {
  id String @id @default(cuid())

  clubId String @map("club_id")
  club   Club   @relation(fields: [clubId], references: [id])

  teamId String           @map("team_id")
  team   Team             @relation(fields: [teamId], references: [id])
  types  ENTrainingType[]

  title       String?
  description String?

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  location String?

  status ENTrainingStatus @default(SCHEDULED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([clubId])
  @@index([teamId])
  @@index([startsAt])
  @@map("trainings")
}

// -- Player Management Feature --
model Player {
  id String @id @default(cuid())

  membershipId String     @map("membership_id")
  membership   Membership @relation(fields: [membershipId], references: [id])

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id])

  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  @@unique([membershipId, teamId])
  @@map("players")
}

// -- Team Management Feature --

model Team {
  id String @id @default(cuid())

  clubId String @map("club_id")
  club   Club   @relation(fields: [clubId], references: [id])

  name String @db.VarChar(50)

  trainings        Training[]
  players          Player[]
  coachAssignments CoachAssignment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("teams")
}
