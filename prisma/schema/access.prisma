enum ENGender {
  MALE
  FEMALE
}

model Person {
  id             String   @id @default(cuid())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  gender         ENGender
  dob            DateTime
  nationality    String
  profilePicture String?  @map("profile_picture")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile?

  user        User?
  memberships Membership[]

  @@map("persons")
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  passwordHash   String  @map("password_hash")

  isEmailVerified Boolean @default(false)
  lastLogin      DateTime? @map("last_login")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  personId String @unique @map("person_id")
  person   Person @relation(fields: [personId], references: [id])

  tokens              UserToken[]
  acceptedInvitations Invitation[] @relation("UserAcceptedInvitations")

  @@map("users")
}

enum ENUserTokenType {
  EMAIL_VERIFICATION
  CHANGE_PASSWORD
}

enum ENUserTokenStatus {
  PENDING
  DISRUPTED
}

model UserToken {
  id        String        @id @default(cuid())
  type      ENUserTokenType
  hash      String        @unique

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  status ENUserTokenStatus @default(PENDING)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])

  @@map("user_tokens")
}

enum ENMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
}

enum ENMembershipType {
  OWNER
  STAFF
  ATHLETE
  GUARDIAN
  BOARD
}

model Membership {
  id String @id @default(cuid())

  status ENMembershipStatus @default(ACTIVE)
  types   MembershipType[]

  joinedAt DateTime  @map("joined_at")
  endedAt  DateTime? @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id])

  clubId String @map("club_id")
  club   Club   @relation("ClubMemberships", fields: [clubId], references: [id])

  roles         MembershipRole[]
  permissions   MembershipPermission[]
  assignedRoles MembershipRole[]       @relation("AssignedRoles")

  createdClubs  Club[]                 @relation("ClubCreator")
  sentInvitations Invitation[]         @relation("MembershipSentInvitations")

  @@index([personId])
  @@index([clubId])
  @@index([status])
  @@map("memberships")
}

model MembershipType {
  membershipId  String
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  type          ENMembershipType

  @@unique([membershipId, type])
}

enum ENPermissionModule {
  ACCESS
  TRAINING
  PLAYER
  MEDICAL
  FINANCE
  MATCH
}

enum ENPermissionAction {
  CREATE
  READ
  WRITE
  DELETE
  APPROVE
  EXPORT
  ASSIGN
}

model Permission {
  id String @id @default(cuid())

  code        String @unique
  name        String
  description String

  module ENPermissionModule
  action ENPermissionAction

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions       RolePermission[]
  membershipPermissions MembershipPermission[]

  @@map("permissions")
}

model Role {
  id String @id @default(cuid())

  code        String @unique
  name        String
  description String

  isSystem Boolean @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships MembershipRole[]
  permissions RolePermission[]

  @@map("roles")
}

enum ENPermissionScope {
  ANY
  CLUB
  TEAM
  OWN
}

model RolePermission {
  id String @id @default(cuid())

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  permissionId String @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  scope ENPermissionScope

  @@unique([roleId, permissionId, scope])

  @@map("role_permissions")
}

model MembershipPermission {
  id String @id @default(cuid())

  membershipId String @map("membership_id")
  membership   Membership @relation(fields: [membershipId], references: [id])

  permissionId String @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  scope ENPermissionScope

  @@unique([membershipId, permissionId, scope])

  @@map("membership_permissions")
}

model MembershipRole {
  id String @id @default(cuid())

  membershipId String @map("membership_id")
  membership   Membership @relation(fields: [membershipId], references: [id])

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  assignedById String? @map("assigned_by")
  assignedBy   Membership? @relation("AssignedRoles", fields: [assignedById], references: [id])

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([membershipId, roleId])

  @@map("membership_roles")
}

enum ENClubStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model Club {
  id        String   @id @default(cuid())
  name      String
  shortName String?  @map("short_name")
  logo      String?
  country   String

  createdById String?     @map("created_by")
  createdBy   Membership? @relation("ClubCreator", fields: [createdById], references: [id])

  status ENClubStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[] @relation("ClubMemberships")
  invitations Invitation[] @relation("ClubInvitations")

  @@index([createdById])
  @@map("clubs")
}

enum ENInvitationStatus {
  PENDING
  DISRUPTED
}

model Invitation {
  id String @id @default(cuid())

  email String

  tokenHash String @unique @map("token_hash")

  type ENMembershipType

  status ENInvitationStatus @default(PENDING)

  expiresAt DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")

  clubId String @map("club_id")
  club Club @relation("ClubInvitations", fields: [clubId], references: [id])

  inviterId String @map("inviter_id")
  inviter Membership @relation("MembershipSentInvitations", fields: [inviterId], references: [id])

  acceptedByUserId String? @map("accepted_by_user_id")
  acceptedByUser User? @relation("UserAcceptedInvitations", fields: [acceptedByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([clubId])
  @@index([expiresAt])

  @@map("invitations")
}